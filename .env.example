# Copiá este archivo a `.env` en la raíz del repo (el `.env` real está gitignored)
# y ajustá los valores. Con estos valores `docker compose up --build` levanta
# db (PostgreSQL) + backend (.NET) + frontend (Angular) end-to-end.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Credenciales del contenedor `db` (postgres:16). docker-compose arma con ellas
# la cadena de conexión Npgsql que le pasa al backend
# (Host=db;Port=5432;Database=$POSTGRES_DB;Username=$POSTGRES_USER;Password=$POSTGRES_PASSWORD).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Admin1234!
POSTGRES_DB=AcademiaDigital

# ── JWT ─────────────────────────────────────────────────────────────────────
# Clave para firmar los JWT (mínimo 32 caracteres). docker-compose la exige
# (Jwt__SecretKey) y falla el arranque si no está. Usar un valor fuerte en
# cualquier entorno real; el de abajo es solo para desarrollo/tesis.
JWT_SECRET_KEY=dev_secret_key_academia_digital_postgres_migration_2026
