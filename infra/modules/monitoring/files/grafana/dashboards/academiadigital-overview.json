      "id": 10,
      "type": "timeseries",
      "title": "Errores en el tiempo",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (service) (count_over_time({service=~\"backend|finance\"} | json | __error__=\"\" | LogLevel=~\"Error|Critical\" [$__interval]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "expr": "sum(count_over_time({service=\"frontend\"} [$__interval]))",
          "legendFormat": "nginx",
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "expr": "sum(count_over_time({service=\"backend\"} | json | __error__=\"\" | State_Event=\"client_error\" [$__interval]))",
          "legendFormat": "navegador",
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Rutas con errores 5xx",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 14,
        "y": 23,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "expr": "topk(10, sum by (State_Path) (count_over_time({service=\"backend\"} | json | __error__=\"\" | State_Event=\"http_request\" | State_Status >= 500 [$__range])))",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ]
    },
    {
      "id": 12,
