      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Logins en el tiempo",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (State_Event) (count_over_time({service=\"backend\"} | json | __error__=\"\" | State_Event=~\"login_success|login_failed\" [$__interval]))",
          "legendFormat": "{{State_Event}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "IPs con más logins fallidos",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 14,
        "y": 5,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "expr": "topk(15, sum by (State_Ip) (count_over_time({service=\"backend\"} | json | __error__=\"\" | State_Event=\"login_failed\" [$__range])))",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ]
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Detalle de accesos",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "expr": "{service=\"backend\"} | json | __error__=\"\" | State_Event=~\"login_success|login_failed|logout\" | line_format \"{{.State_Event}} ip={{.State_Ip}} usuario={{.State_UserId}} rol={{.State_Role}} estado={{.State_Status}}\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Errores",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
