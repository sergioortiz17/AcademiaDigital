{
  "name": "academia-digital-api-regression",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright API regression suite for AcademiaDigital",
  "scripts": {
    "clean:results": "node scripts/clean-results.mjs",
    "pretest:api": "npm run clean:results",
    "pretest:api:smoke": "npm run clean:results",
    "pretest:api:critical": "npm run clean:results",
    "pretest:api:regression": "npm run clean:results",
    "pretest:api:negative": "npm run clean:results",
    "pretest:api:auth": "npm run clean:results",
    "pretest:api:populate": "npm run clean:results",
    "pretest:api:p1": "npm run clean:results",
    "typecheck": "tsc --noEmit",
    "test:migration": "node scripts/test-migration-backfill.mjs",
    "test:api": "playwright test",
    "test:api:smoke": "playwright test --grep @smoke",
    "test:api:critical": "playwright test --grep @critical",
    "test:api:regression": "playwright test --grep @regression",
    "test:api:negative": "playwright test --grep @negative",
    "test:api:auth": "playwright test --grep @authorization",
    "test:api:p1": "playwright test --grep @p1",
    "test:api:populate": "node scripts/run-populate.mjs",
    "db:population-summary": "node scripts/population-summary.mjs",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "e2e:up": "docker compose -f docker-compose.e2e.yml up -d --build --wait",
    "e2e:down": "docker compose -f docker-compose.e2e.yml down",
    "e2e:reset": "docker compose -f docker-compose.e2e.yml down -v && docker compose -f docker-compose.e2e.yml up -d --build --wait"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.15.0",
    "allure-commandline": "^2.34.1",
    "allure-js-commons": "^3.3.3",
    "allure-playwright": "^3.3.3",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.1",
    "mssql": "^11.0.1",
    "typescript": "^5.9.2",
    "zod": "^4.0.17"
  }
}
