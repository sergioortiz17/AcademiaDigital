        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "expr": "{service=~\"backend|finance\"} | json | __error__=\"\" | LogLevel=~\"Error|Critical\" | line_format \"[{{.service}}] {{.Category}}: {{.Message}} {{.Exception}}\"",
          "refId": "A",
