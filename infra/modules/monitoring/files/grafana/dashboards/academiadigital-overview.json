        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(sum by (State_UserId) (count_over_time({service=\"backend\"} | json | __error__=\"\" | State_Event=\"login_success\" [$__range])))",
