# Grafana + Loki + Prometheus en la instancia de monitoreo. Lo levanta monitoring.service
# desde /opt/monitoring/config (sincronizado desde S3). Generado por Terraform: no editar
# en la instancia, editar infra/modules/monitoring/files/ y aplicar.

services:
  loki:
    image: ${images.loki}
    command: ["-config.file=/etc/loki/loki.yaml"]
    ports:
      - "3100:3100" # el security group solo deja entrar a las instancias de la app
    volumes:
      - ./loki.yaml:/etc/loki/loki.yaml:ro
      - loki-data:/loki
    restart: unless-stopped
    mem_limit: 600m

  prometheus:
    image: ${images.prometheus}
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=${prometheus_retention_days}d
      - --web.enable-remote-write-receiver
    ports:
      - "9090:9090" # el security group solo deja entrar a las instancias de la app
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    restart: unless-stopped
    mem_limit: 500m

  grafana:
    image: ${images.grafana}
    env_file: /opt/monitoring/.env # GF_SECURITY_ADMIN_PASSWORD (desde SSM)
    environment:
      GF_SERVER_HTTP_PORT: "3000"
      GF_SERVER_ROOT_URL: http://localhost:3000
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
    ports:
      - "127.0.0.1:3000:3000" # solo localhost: se entra por Session Manager
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
      - grafana-data:/var/lib/grafana
    depends_on:
      - loki
      - prometheus
    restart: unless-stopped
    mem_limit: 400m

volumes:
  loki-data:
  prometheus-data:
  grafana-data:
